<?xml version="1.0"?>
<launch>
  <!-- SLAM 建图（gmapping），自己拼装以便切换参数文件：
       - gmapping_params:=<yaml>  选择参数组（默认 A 组=官方参数）
       - open_rviz:=false        无界面运行（自动化测试）
       与官方 turtlebot3_slam.launch 的唯一区别是参数文件可切换；
       同时保证 robot_state_publisher 会被启动（激光坐标系靠它发布，
       少了它 gmapping 会 100% 丢帧）。 -->
  <arg name="model" default="waffle_pi"/>
  <arg name="open_rviz" default="true"/>
  <!-- 默认用 E 组参数（A–E 对照实验的最优推荐：与 C 同质量、更新次数少约 1/3）。
       想用官方默认参数：gmapping_params:=$(find turtlebot3_slam)/config/gmapping_params.yaml -->
  <arg name="gmapping_params"
       default="$(env HOME)/xzy-project/launch/gmapping_params_E_fine.yaml"/>

  <!-- TurtleBot3（robot_state_publisher） -->
  <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch">
    <arg name="model" value="$(arg model)"/>
  </include>

  <!-- gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="turtlebot3_slam_gmapping"
        output="screen">
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <rosparam command="load" file="$(arg gmapping_params)"/>
  </node>

  <!-- RViz -->
  <group if="$(arg open_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find turtlebot3_slam)/rviz/turtlebot3_gmapping.rviz"/>
  </group>
</launch>
